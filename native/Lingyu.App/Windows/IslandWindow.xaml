     @file IslandWindow.xaml @description 三形态胶囊，全部为原生可操作控件。 @author 灵屿 -->
<Window x:Class="Lingyu.App.Windows.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Lingyu.App.Controls" xmlns:l="clr-namespace:Lingyu.App.Localization" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" Width="320" Height="76" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" Title="{l:L brand}" PreviewKeyDown="OnKeyDown">
  <Grid Margin="18,10,18,22">
    <c:MaterialFrame x:Name="Shell" Radius="160" MouseEnter="OnEnter" MouseLeave="OnLeave" PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseLeftButtonUp="OnPointerUp">
      <Grid>
        <Grid x:Name="Docked" Margin="18,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
          <c:Glyph Kind="{Binding IslandGlyph}" Width="23" Height="23" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding IslandLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
          <c:Glyph Grid.Column="2" Kind="expand" Width="16" Height="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="Hover" Visibility="Collapsed" Margin="26,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
          <c:AlbumArt Width="36" Height="36" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="{Binding IslandLabel}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TrackArtist}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" /></StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="{l:L previous}" AutomationProperties.Name="{l:L previous}" IsEnabled="{Binding CanPrevious}" Click="Previous"><c:Glyph Kind="previous" /></Button>
          <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="{l:L playPause}" AutomationProperties.Name="{l:L playPause}" IsEnabled="{Binding CanPlay}" Click="Play"><c:Glyph Kind="{Binding PlayGlyph}" /></Button>
          <Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="{l:L next}" AutomationProperties.Name="{l:L next}" IsEnabled="{Binding CanNext}" Click="Next"><c:Glyph Kind="next" /></Button>
          <Button Grid.Column="5" Style="{StaticResource IconButton}" ToolTip="{l:L openWorkspace}" AutomationProperties.Name="{l:L openWorkspace}" Click="Workspace"><c:Glyph Kind="monitor" /></Button>
        </Grid>
        <Grid x:Name="Expanded" Visibility="Collapsed" Margin="34,28,34,26">
          <Grid.ColumnDefinitions><ColumnDefinition Width="4.1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="2.7*" /></Grid.ColumnDefinitions>
          <Grid Margin="0,0,24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="104" Height="132" VerticalAlignment="Top"><c:AlbumArt /><Image x:Name="Cover" Source="{Binding Artwork}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,104,132" RadiusX="12" RadiusY="12" /></Image.Clip></Image></Grid>
            <StackPanel Grid.Column="1" Margin="8,3,0,0"><TextBlock Text="{Binding TrackTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TrackArtist}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{l:L timeCaption}" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,17,0,0" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,95,0,0" VerticalAlignment="Top"><Slider Value="{Binding MediaProgress, Mode=OneWay}" IsEnabled="{Binding CanSeek}" Minimum="0" Maximum="100" PreviewMouseLeftButtonUp="Seek" AutomationProperties.Name="{l:L seek}" /><DockPanel Margin="0,1,0,0"><TextBlock Text="{Binding MediaTime}" FontSize="10" Foreground="{StaticResource Faint}" /><TextBlock Text="{Binding MediaDuration}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" /></DockPanel></StackPanel>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,0"><Button Style="{StaticResource IconButton}" IsEnabled="{Binding CanPrevious}" Click="Previous" ToolTip="{l:L previous}" AutomationProperties.Name="{l:L previous}"><c:Glyph Kind="previous" /></Button><Button Style="{StaticResource RoundButton}" IsEnabled="{Binding CanPlay}" Click="Play" ToolTip="{l:L playPause}" AutomationProperties.Name="{l:L playPause}" Margin="13,0"><c:Glyph Kind="{Binding PlayGlyph}" /></Button><Button Style="{StaticResource IconButton}" IsEnabled="{Binding CanNext}" Click="Next" ToolTip="{l:L next}" AutomationProperties.Name="{l:L next}"><c:Glyph Kind="next" /></Button></StackPanel>
          </Grid>
          <Border Grid.Column="1" Background="{StaticResource Line}" Margin="0,2" />
          <Grid Grid.Column="2" Margin="27,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><c:Glyph Kind="{Binding WeatherGlyph}" Width="40" Height="40" Foreground="#DDD9EA" Margin="0,4,16,0" /><StackPanel><TextBlock Text="{Binding WeatherCityName}" FontSize="17" FontWeight="Medium" /><TextBlock Text="{Binding WeatherDescription}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,56,0,0" VerticalAlignment="Top"><TextBlock Text="{Binding Temperature}" FontSize="48" FontWeight="Medium" /><TextBlock Text="{Binding HighLow}" Margin="12,22,0,0" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
            <StackPanel x:Name="ForecastPanel" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
            <Button x:Name="ChooseWeather" Style="{StaticResource Button}" Content="{l:L weatherChoose}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Click="Weather" />
          </Grid>
          <Border Grid.Column="3" Background="{StaticResource Line}" Margin="0,2" />
          <Grid Grid.Column="4" Margin="28,0,0,0">
            <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource Muted}" />
            <TextBlock Text="{Binding Time}" FontSize="48" FontWeight="Medium" Margin="0,19,0,0" VerticalAlignment="Top" />
            <TextBlock Text="{l:L timeCaption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,82,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
            <Grid Margin="0,116,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><Button Width="24" Height="24" Padding="2" Style="{StaticResource IconButton}" Click="Mute" ToolTip="{l:L mute}" AutomationProperties.Name="{l:L mute}"><c:Glyph Kind="volume" /></Button><Slider Grid.Column="1" Value="{Binding Volume, Mode=OneWay}" IsEnabled="{Binding VolumeAvailable}" Maximum="100" Margin="12,0" ValueChanged="VolumeChanged" AutomationProperties.Name="{l:L volume}" /><TextBlock Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" /></Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"><Button Style="{StaticResource IconButton}" Click="Focus" ToolTip="{l:L focus}" AutomationProperties.Name="{l:L focus}" Margin="0,0,9,0"><c:Glyph Kind="focus" /></Button><Button Style="{StaticResource IconButton}" Click="Quiet" ToolTip="{l:L quiet}" AutomationProperties.Name="{l:L quiet}" Margin="0,0,9,0"><c:Glyph Kind="moon" /></Button><Button Style="{StaticResource IconButton}" Click="Workspace" ToolTip="{l:L openWorkspace}" AutomationProperties.Name="{l:L openWorkspace}" Margin="0,0,9,0"><c:Glyph Kind="monitor" /></Button><Button Style="{StaticResource IconButton}" Click="Settings" ToolTip="{l:L settings}" AutomationProperties.Name="{l:L settings}"><c:Glyph Kind="settings" /></Button></StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </c:MaterialFrame>
  </Grid>
</Window>
