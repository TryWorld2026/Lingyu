     @file IslandWindow.xaml @description 共用轮廓与封面的真实活动布局。 @author 灵屿 -->
<Window x:Class="Lingyu.App.Windows.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Lingyu.App.Controls" xmlns:l="clr-namespace:Lingyu.App.Localization" WindowStyle="None" ResizeMode="NoResize" Background="#0B0C10" Topmost="True" ShowActivated="False" ShowInTaskbar="False" Width="1000" Height="340" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" Title="{l:L brand}" PreviewKeyDown="OnKeyDown">
  <Canvas x:Name="Stage" PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseLeftButtonUp="OnPointerUp" MouseEnter="OnEnter" MouseLeave="OnLeave">
    <Border x:Name="Shell" Width="280" Height="44" Background="{StaticResource IslandSurface}" BorderBrush="{StaticResource IslandEdge}" BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" />
    <Grid x:Name="Docked" Width="280" Height="44" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="DockedLabel" Text="{Binding IslandLabel}" FontSize="13" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <c:Glyph x:Name="DockedExpand" Grid.Column="2" Kind="expand" Width="15" Height="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      <c:PlaybackPulse x:Name="CompactPulse" Grid.Column="1" Grid.ColumnSpan="2" Width="50" Height="24" Margin="0,0,22,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsPlaying="{Binding IsPlaying}" ReduceMotion="{Binding ReduceMotion}" Accent="{DynamicResource MusicAccent}" Visibility="Collapsed" AutomationProperties.Name="{l:L musicPlaybackStatus}" />
    </Grid>
    <Grid x:Name="Hover" Width="500" Height="72" Background="Transparent" Opacity="0" IsHitTestVisible="False">
      <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="144" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding IslandHoverLabel}" ToolTip="{Binding IslandHoverLabel}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding IslandSubLabel}" ToolTip="{Binding IslandSubLabel}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
      <StackPanel x:Name="HoverMusic" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Click="Previous" ToolTip="{l:L previous}" AutomationProperties.Name="{l:L previous}" IsEnabled="{Binding CanPrevious}"><c:Glyph Kind="previous" /></Button><Button Style="{StaticResource IconButton}" Click="Play" ToolTip="{l:L playPause}" AutomationProperties.Name="{l:L playPause}" IsEnabled="{Binding CanPlay}"><c:Glyph Kind="{Binding PlayGlyph}" /></Button><Button Style="{StaticResource IconButton}" Click="Next" ToolTip="{l:L next}" AutomationProperties.Name="{l:L next}" IsEnabled="{Binding CanNext}"><c:Glyph Kind="next" /></Button></StackPanel>
      <StackPanel x:Name="HoverFocus" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"><Button Style="{StaticResource IconButton}" Click="ToggleFocus" ToolTip="{Binding FocusAction}" AutomationProperties.Name="{Binding FocusAction}"><c:Glyph Kind="{Binding FocusPlayGlyph}" /></Button><Button Style="{StaticResource IconButton}" Click="EndFocus" ToolTip="{Binding FocusEndAction}" AutomationProperties.Name="{Binding FocusEndAction}" AutomationProperties.AutomationId="HoverFocusEnd"><c:Glyph Kind="{Binding FocusEndGlyph}" /></Button></StackPanel>
      <Button x:Name="HoverAi" Grid.Column="2" Style="{StaticResource IconButton}" Click="StopAi" ToolTip="{l:L aiStop}" AutomationProperties.Name="{l:L aiStop}" Visibility="Collapsed"><c:Glyph Kind="stop" /></Button>
      <Button Style="{StaticResource IconButton}" Click="Workspace" ToolTip="{l:L openWorkspace}" AutomationProperties.Name="{l:L openWorkspace}" Grid.Column="3"><c:Glyph Kind="monitor" /></Button>
    </Grid>
    <Grid x:Name="MusicDetails" AutomationProperties.AutomationId="MusicDetails" Width="420" Height="248" Background="Transparent" Opacity="0" IsHitTestVisible="False">
      <Grid Margin="24,24,24,20">
        <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="40" /><RowDefinition Height="52" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="DetailsArtworkColumn" Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding TrackTitle}" ToolTip="{Binding TrackTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="24" LineStackingStrategy="BlockLineHeight" MaxHeight="48" />
            <TextBlock Text="{Binding TrackArtist}" ToolTip="{Binding TrackArtist}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding MusicLyric}" ToolTip="{Binding MusicLyric}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="16" /></Grid.RowDefinitions>
          <Slider x:Name="MusicDetailsSeek" Foreground="{DynamicResource MusicAccent}" AutomationProperties.AutomationId="MusicDetailsSeek" AutomationProperties.Name="{l:L mediaSeek}" Value="{Binding MediaProgress, Mode=OneWay}" Maximum="100" IsMoveToPointEnabled="True" IsEnabled="{Binding CanSeek}" GotMouseCapture="BeginSeek" LostMouseCapture="EndSeek" ToolTip="{Binding MediaSeekHint}" ToolTipService.ShowOnDisabled="True" />
          <DockPanel Grid.Row="1"><TextBlock Text="{Binding MediaDuration}" FontSize="10" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding MediaTime}" FontSize="10" Foreground="{StaticResource Muted}" /></DockPanel>
        </Grid>
        <Grid Grid.Row="3">
          <Button x:Name="MusicOverview" AutomationProperties.AutomationId="MusicOverview" AutomationProperties.Name="{l:L islandOverview}" ToolTip="{l:L islandOverview}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="ShowOverview"><c:Glyph Kind="monitor" /></Button>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Click="Previous" ToolTip="{l:L previous}" AutomationProperties.Name="{l:L previous}" IsEnabled="{Binding CanPrevious}"><c:Glyph Kind="previous" /></Button>
            <Button Style="{StaticResource RoundButton}" Click="Play" Margin="4,0" ToolTip="{l:L playPause}" AutomationProperties.Name="{l:L playPause}" IsEnabled="{Binding CanPlay}"><c:Glyph Kind="{Binding PlayGlyph}" /></Button>
            <Button Style="{StaticResource IconButton}" Click="Next" ToolTip="{l:L next}" AutomationProperties.Name="{l:L next}" IsEnabled="{Binding CanNext}"><c:Glyph Kind="next" /></Button>
          </StackPanel>
          <Button x:Name="MusicCollapse" AutomationProperties.AutomationId="MusicCollapse" AutomationProperties.Name="{l:L islandCollapse}" ToolTip="{l:L islandCollapse}" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CollapseMusic"><c:Glyph Kind="expand" /></Button>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="Expanded" Width="1000" Height="280" Background="Transparent" Opacity="0" IsHitTestVisible="False">
      <Grid x:Name="ExpandedLayout" Margin="34,32,34,28">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="4.4*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="2.7*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="2.5*" /></Grid.ColumnDefinitions>
        <Grid x:Name="MusicPanel" Margin="0,0,22,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="60" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="MusicArtworkColumn" Width="148" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="0,3,0,0"><TextBlock Text="{Binding TrackTitle}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TrackArtist}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,8,0,12" /><TextBlock Text="{Binding CurrentLyric}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="44" />
              <Slider x:Name="MediaSeek" Foreground="{DynamicResource MusicAccent}" Value="{Binding MediaProgress, Mode=OneWay}" Maximum="100" IsMoveToPointEnabled="True" IsEnabled="{Binding CanSeek}" GotMouseCapture="BeginSeek" LostMouseCapture="EndSeek" ToolTip="{Binding MediaSeekHint}" ToolTipService.ShowOnDisabled="True" Margin="0,16,0,4" AutomationProperties.Name="{l:L mediaSeek}" />
              <DockPanel><TextBlock Text="{Binding MediaDuration}" FontSize="10" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding MediaTime}" FontSize="10" Foreground="{StaticResource Muted}" /></DockPanel>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"><Button x:Name="MusicBack" AutomationProperties.AutomationId="MusicBack" AutomationProperties.Name="{l:L islandBackToMusic}" ToolTip="{l:L islandBackToMusic}" Style="{StaticResource IconButton}" Click="ShowMusic"><c:Glyph Kind="music" Width="16" Height="16" /></Button><Button Style="{StaticResource IconButton}" Click="Previous" ToolTip="{l:L previous}" AutomationProperties.Name="{l:L previous}" IsEnabled="{Binding CanPrevious}"><c:Glyph Kind="previous" /></Button><Button Style="{StaticResource RoundButton}" Click="Play" Margin="4,0" ToolTip="{l:L playPause}" AutomationProperties.Name="{l:L playPause}" IsEnabled="{Binding CanPlay}"><c:Glyph Kind="{Binding PlayGlyph}" /></Button><Button Style="{StaticResource IconButton}" Click="Next" ToolTip="{l:L next}" AutomationProperties.Name="{l:L next}" IsEnabled="{Binding CanNext}"><c:Glyph Kind="next" /></Button><Button Style="{StaticResource IconButton}" Click="Players" ToolTip="{l:L musicOptions}" AutomationProperties.Name="{l:L musicOptions}" Margin="0"><c:Glyph Kind="settings" /></Button></StackPanel>
        </Grid>
        <Border x:Name="WeatherDivider" Grid.Column="1" Background="{StaticResource Line}" />
        <StackPanel x:Name="WeatherPanel" Grid.Column="2" Margin="25,0,22,0"><Button Click="Weather" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ToolTip="{l:L weatherChoose}" AutomationProperties.Name="{l:L weatherChoose}"><DockPanel><c:Glyph Kind="{Binding WeatherGlyph}" Width="36" Height="32" Foreground="{StaticResource Ink}" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding WeatherCityName}" FontSize="17" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding WeatherDescription}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DockPanel></Button><TextBlock Text="{Binding Temperature}" FontSize="46" Margin="0,12,0,3" /><TextBlock Text="{Binding HighLow}" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding WeatherUpdateStatus}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" ToolTip="{Binding WeatherUpdatedAt}" /><UniformGrid x:Name="ForecastPanel" Rows="1" Margin="0,12,0,0" /></StackPanel>
        <Border x:Name="QuickDivider" Grid.Column="3" Background="{StaticResource Line}" />
        <Grid x:Name="QuickPanel" Grid.Column="4" Margin="25,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="QuickDate" Text="{Binding Date}" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="QuickTime" Text="{Binding Time}" FontSize="42" Grid.Row="1" Margin="0,5,0,9" />
          <StackPanel x:Name="VolumePanel" Grid.Row="2"><TextBlock x:Name="QuickCaption" Text="{l:L timeCaption}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /><Button x:Name="WeatherSummary" Visibility="Collapsed" Click="Weather" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" ToolTip="{l:L weatherChoose}" AutomationProperties.Name="{l:L weatherChoose}"><TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding WeatherCityName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Temperature, Mode=OneWay}" /></TextBlock></Button><Slider Value="{Binding Volume, Mode=OneWay}" Maximum="100" IsEnabled="{Binding VolumeAvailable}" ValueChanged="VolumeChanged" Margin="0,18,0,0" AutomationProperties.Name="{l:L volume}" /></StackPanel>
          <StackPanel x:Name="QuickActions" Grid.Row="3" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="Mute" IsEnabled="{Binding VolumeAvailable}" ToolTip="{l:L mute}" AutomationProperties.Name="{l:L mute}" ><c:Glyph Kind="volume" /></Button><Button Style="{StaticResource IconButton}" Click="Focus" ToolTip="{l:L focus}" AutomationProperties.Name="{l:L focus}" ><c:Glyph Kind="focus" /></Button><Button Style="{StaticResource IconButton}" Click="Workspace" ToolTip="{l:L openWorkspace}" AutomationProperties.Name="{l:L openWorkspace}" ><c:Glyph Kind="monitor" /></Button><Button Style="{StaticResource IconButton}" Click="Settings" ToolTip="{l:L settings}" AutomationProperties.Name="{l:L settings}" ><c:Glyph Kind="settings" /></Button></StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="FocusExpanded" Width="680" Height="232" Background="Transparent" Opacity="0" IsHitTestVisible="False">
      <Grid x:Name="FocusLayout" Margin="36,25"><Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel x:Name="FocusCaption" VerticalAlignment="Center" Margin="0,0,12,0"><c:Glyph Kind="{Binding IslandGlyph}" Width="30" Height="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" /><TextBlock Text="{Binding FocusRingLabel}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,7" /><TextBlock Text="{Binding FocusDetail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
        <Grid Grid.Column="1" Width="180" Height="180"><c:FocusRing Progress="{Binding FocusProgress}" /><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding FocusTime}" FontSize="39" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding FocusRingLabel}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel></Grid>
        <StackPanel x:Name="FocusActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Click="ToggleFocus" ToolTip="{Binding FocusAction}" AutomationProperties.Name="{Binding FocusAction}" AutomationProperties.AutomationId="IslandFocusToggle"><c:Glyph Kind="{Binding FocusPlayGlyph}" /></Button><Button Style="{StaticResource IconButton}" Click="EndFocus" ToolTip="{Binding FocusEndAction}" AutomationProperties.Name="{Binding FocusEndAction}" AutomationProperties.AutomationId="IslandFocusEnd" Margin="12,0"><c:Glyph Kind="{Binding FocusEndGlyph}" /></Button><Button Style="{StaticResource IconButton}" Click="Focus" ToolTip="{l:L openWorkspace}" AutomationProperties.Name="{l:L openWorkspace}"><c:Glyph Kind="monitor" /></Button></StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="AiExpanded" Width="460" Height="160" Background="Transparent" Opacity="0" IsHitTestVisible="False">
      <Grid Margin="32,23"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><c:Glyph Kind="ai" Width="28" Height="28" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,4,0,0" />
        <StackPanel Grid.Column="1"><TextBlock Text="{l:L ai}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{l:L aiThinking}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,16" /><Button Click="AiWorkspace" Content="{l:L aiOpenWorkspace}" HorizontalAlignment="Left" Padding="12,8" /></StackPanel>
        <Button Style="{StaticResource IconButton}" Click="StopAi" ToolTip="{l:L aiStop}" AutomationProperties.Name="{l:L aiStop}" Grid.Column="2" VerticalAlignment="Top"><c:Glyph Kind="stop" /></Button>
      </Grid>
    </Grid>
    <Grid x:Name="SharedArtwork" Width="26" Height="26" IsHitTestVisible="False"><c:AlbumArt x:Name="SampleArt" /><c:Glyph x:Name="FallbackArt" Kind="music" Foreground="{StaticResource Accent}" Margin="7" /><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Grid>
    <c:Glyph x:Name="ActivityIcon" Kind="logo" Width="24" Height="24" Foreground="{StaticResource Accent}" IsHitTestVisible="False" />
    <TextBlock x:Name="SampleTag" Text="{l:L sampleShort}" FontSize="9" Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
  </Canvas>
</Window>
