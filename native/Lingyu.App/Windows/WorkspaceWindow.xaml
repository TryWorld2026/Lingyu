     @file WorkspaceWindow.xaml @description 按需创建和关闭释放的原生工作台。 @author 灵屿 -->
<Window x:Class="Lingyu.App.Windows.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Lingyu.App.Controls" xmlns:l="clr-namespace:Lingyu.App.Localization" WindowStyle="None" ResizeMode="CanResize" Background="#0B0C10" Width="1120" Height="740" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" UseLayoutRounding="True" Title="{l:L brand}">
  <Grid>
    <Border Background="{StaticResource WorkspaceSurface}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border BorderBrush="#26272E" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragTitle">
          <Grid Margin="22,0,13,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><c:Glyph Kind="logo" Width="32" Height="25" Margin="0,0,13,0" /><TextBlock Text="{l:L brand}" FontWeight="SemiBold" FontSize="18" /><TextBlock x:Name="PreviewLabel" Text="{l:L preview}" FontSize="10" Foreground="{StaticResource Faint}" Margin="16,5,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" ToolTip="{l:L minimize}" AutomationProperties.Name="{l:L minimize}" Click="Minimize"><c:Glyph Kind="minimize" Width="17" Height="17" /></Button><Button Style="{StaticResource IconButton}" ToolTip="{l:L maximize}" AutomationProperties.Name="{l:L maximize}" Click="Maximize"><c:Glyph Kind="maximize" Width="15" Height="15" /></Button><Button Style="{StaticResource IconButton}" ToolTip="{l:L close}" AutomationProperties.Name="{l:L close}" AutomationProperties.AutomationId="WorkspaceClose" Click="CloseWindow"><c:Glyph Kind="close" Width="17" Height="17" /></Button></StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="202" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#09101210" BorderBrush="#282930" BorderThickness="0,0,1,0">
            <Grid x:Name="SidebarBody" Margin="15,24,15,22">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="Navigation" /><StackPanel x:Name="Recent" Margin="0,28,0,0" /></StackPanel></ScrollViewer>
              <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Click="Settings" ToolTip="{l:L settings}" AutomationProperties.Name="{l:L settings}"><StackPanel Orientation="Horizontal"><c:Glyph Kind="settings" Width="18" Height="18" Foreground="{StaticResource Muted}" /><TextBlock x:Name="SettingsLabel" Text="{l:L settings}" FontSize="13" Margin="13,0,0,0" /></StackPanel></Button>
                <Button x:Name="ReturnToIsland" AutomationProperties.AutomationId="ReturnToIsland" Style="{StaticResource NavButton}" Click="ReturnIsland" ToolTip="{l:L backIsland}" AutomationProperties.Name="{l:L backIsland}"><StackPanel Orientation="Horizontal"><c:Glyph Kind="logo" Width="18" Height="18" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ReturnLabel" Text="{l:L backIsland}" FontSize="12" Foreground="{StaticResource Muted}" Margin="13,0,0,0" /></StackPanel></Button>
              </StackPanel>
            </Grid>
          </Border>
          <Grid x:Name="PageLayout" Grid.Column="1" Margin="32,28,32,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border x:Name="SampleMarker" Visibility="Collapsed" Margin="0,0,0,16"><TextBlock Text="{l:L sample}" FontSize="10" Foreground="{StaticResource Accent}" TextWrapping="Wrap" /></Border><ContentControl x:Name="Page" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /><TextBlock x:Name="Status" Grid.Row="2" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,13,0,0" /></Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
