{
  "appId": "com.lingyu.app",
  "productName": "Lingyu",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "!out/renderer/.vite/**"
  ],
  "asarUnpack": [
    "node_modules/@lingyu/**/src/bin/Release/**/*",
    "node_modules/@lingyu/**/*.node",
    "node_modules/koffi/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/icon",
      "to": "icon",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/capture.html",
      "to": "capture.html"
    },
    {
      "from": "resources/capture.css",
      "to": "capture.css"
    },
    {
      "from": "resources/capture.js",
      "to": "capture.js"
    },
    {
      "from": "resources/svg",
      "to": "svg",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "node_modules/@lingyu/windows-brightness-helper/src/bin/Release/net10.0",
      "to": "helpers/brightness",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "node_modules/@lingyu/windows-volume-helper/src/bin/Release/net10.0",
      "to": "helpers/volume",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "node_modules/ffmpeg-static/ffmpeg.exe",
      "to": "ffmpeg/ffmpeg.exe"
    }
  ],
  "win": {
    "icon": "resources/icon/lingyu_256x256.ico",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "${productName}-${version}-Setup.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "TryWorld2026",
    "repo": "Lingyu",
    "private": false,
    "releaseType": "release"
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable.${ext}"
  },
  "afterPack": "scripts/after-pack-icon.js"
}